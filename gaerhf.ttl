:marble-figurines-knossos a :human-figure ;
   rdfs:label "Neolithic Marble Figurine from Knossos" ;
   :described-by <https://fr.wikipedia.org/wiki/Préhistoire_de_la_Crète#Céramique_et_autres_objets_mobiliers> ;
   :earliest-date -6500 ;
