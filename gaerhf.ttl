:suda-hachiman-shrine-mirror a :group-of-human-figures ;
   rdfs:label "Suda Hachiman Shrine Mirror" ;
   :described-by <https://en.wikipedia.org/wiki/Suda_Hachiman_Shrine_Mirror> ,
      <https://laits.utexas.edu/~mr56267/HIST_341K/Ancient_pages/Kofun_era_mirror.html> ,
      <https://ja.wikipedia.org/wiki/%E9%9A%85%E7%94%B0%E5%85%AB%E5%B9%A1%E7%A5%9E%E7%A4%BE%E4%BA%BA%E7%89%A9%E7%94%BB%E5%83%8F%E9%8F%A1> ;
   :earliest-date 443 ;
   :latest-date 503 ;
   :in-modern-country-note "Japan" ;
   :material-note "Bronze" ;
   :height 0.199 ;
   :apparent-gender :male , :female ;
   :note "From UT Austin course page: “This mirror, from Suda Hachiman shrine in Wakayama, includes one of the oldest examples of writing in Japan. The inscription along the edge says that the mirror was made for a king Oshisaka no miya on the tenth day of the eight month of either 443 or 503 (the sixty year zodaical cycle makes this unclear).” ... Translated from Japanese Wikipedia: “Bronze, 19.9 cm in diameter. ... In the inner zone are nine human figures, including Dong Wanggong and Xi Wangmu, legendary figures of ancient China.”" ;
   :representative-latlong-point (34.33319444 135.64555556) ; # Suda Hachiman Shrine, Hashimoto, from Japanese Wikipedia (exact find-spot unknown)
   :wikimedia-commons-image-page <https://commons.wikimedia.org/wiki/File:Sumida_Hatiman_Mirror.JPG> .

:mankuwar-buddha a :human-figure ;
