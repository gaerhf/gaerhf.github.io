:calvatone-victoria a :human-figure ;
   rdfs:label "Calvatone Victoria" ;
   :described-by <https://en.wikipedia.org/wiki/Calvatone_Victoria> ,
      <https://commons.wikimedia.org/wiki/Category:Victory_of_Calvatone> ;
   :earliest-date 161 ;
   :latest-date 169 ;
   :material-note "Gilt bronze" ;
   :apparent-gender :female ;
   :in-modern-country-note "Italy" ;
   :note "From Wikipedia: “The Calvatone Victoria is a gilt bronze statue from the Roman Imperial period. ... The statue was discovered at Calvatone, near Cremona in Italy in 1836, in four pieces.” The inscription reads “Victoriae Aug(ustorum) / Antonini et Veri / M(arcus) Satrius Maior”, dating it to the joint reign of Marcus Aurelius and Lucius Verus (161–169). Acquired by the Berlin Antikensammlung in 1841; taken to the Soviet Union in 1946 and now in the Hermitage." ;
   :representative-latlong-point (45.1267 10.4408) ; # ll for Calvatone (ancient Bedriacum)
   :wikimedia-commons-image-page <https://commons.wikimedia.org/wiki/File:Victory_of_Calvatone_(1)_(cropped).jpg> .

