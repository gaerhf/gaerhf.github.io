:funen-bracteate a :human-figure ;
   rdfs:label "Funen Bracteate" ;
   :described-by <https://natmus.dk/historisk-viden/temaer/genstande-af-enestaaende-betydning/genstande-fra-danmarks-oldtid/guldbrakteat/> ,
    <https://artofthemiddleages.com/s/main/item/2407> ;
   :earliest-date 400 ;
   :latest-date 500 ;
   :material-note "Gold" ;
   :note "Unknown findspot on Funen Island. Automatically translated from National Museum Denmark website: “The image on the bracteate shows a man with a diadem and long, braided hair. He stands behind an animal with a harness and a ponytail. One of his hands is on the animal's neck, and his foot is visible between its front legs.” " ;
   :in-modern-country-note "Denmark" ;
   :representative-latlong-point (55.270023  10.329369 ) ;
   :wikimedia-commons-image-page <https://commons.wikimedia.org/wiki/File:Bracteate_from_Funen,_Denmark_(DR_BR42).jpg> .

