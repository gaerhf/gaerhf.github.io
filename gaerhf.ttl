   :earliest-date -1000 ;
   :latest-date -500 ;
   :in-modern-country-note "United States" ;
   :material-note "Whalebone" ;
   :note "From Arctic Archaeology article: “The second mask (60.1–5834) is oval with a pointed head, large round eyes, and an open mouth with carved lips and tongue. The mouth has human teeth inset in both the upper and lower jaws (Fig. 7).  ... ”" ;
   :representative-latlong-point (55.99 -160.57) ;
   :thumbnail-image <https://lbry-web-007.amnh.org/digital/files/original/1d69028b072c27e87f6c6cbb006bcdc4.jpg> .

